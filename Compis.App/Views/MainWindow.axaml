
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Compis.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Compis.App.Controls"
        mc:Ignorable="d"
        x:Class="Compis.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Compis"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#191B1F">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

        <Window.Styles>
                <Style Selector="TextBox">
                        <Setter Property="Background" Value="#202327"/>
                        <Setter Property="Foreground" Value="#EEEEEE"/>
                        <Setter Property="BorderBrush" Value="#41454A"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="MinHeight" Value="32"/>
                </Style>
                <Style Selector="ToggleButton">
                        <Setter Property="Width" Value="36"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#B8BBC0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                </Style>
                <Style Selector="ToggleButton:checked">
                        <Setter Property="Background" Value="#3A3E44"/>
                        <Setter Property="Foreground" Value="#D4AA77"/>
                </Style>
        </Window.Styles>

    <Grid RowDefinitions="56,*,28"
          Background="#191B1F">

        <!-- TOP MENU BAR -->

        <Border Grid.Row="0"
                Background="#24272B"
                BorderBrush="#35393E"
                BorderThickness="0,0,0,1">

                <Grid ColumnDefinitions="*,Auto"
                        Margin="16,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="12">

                    <TextBlock Text="C"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#C69B65"/>

                    <TextBlock Text="COMPIS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#EEEEEE"
                               VerticalAlignment="Center"/>

                </StackPanel>

                                <TextBlock Grid.Column="1"
                           Text="UNTITLED PROJECT"
                           FontSize="10"
                           Foreground="#858A91"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>


        <!-- MAIN WORKSPACE -->

        <Grid Grid.Row="1"
              ColumnDefinitions="56,*,296">

            <!-- LEFT TOOLBAR -->

            <Border Grid.Column="0"
                    Background="#24272B"
                    BorderBrush="#35393E"
                    BorderThickness="0,0,1,0">

                <StackPanel Margin="10,16"
                            Spacing="8">

                    <ToggleButton Content="✥"
                            FontSize="20"
                            IsChecked="{Binding IsTranslateMode, Mode=TwoWay}"
                            ToolTip.Tip="Move selected box"/>

                    <ToggleButton Content="↻"
                            FontSize="20"
                            IsChecked="{Binding IsRotateMode, Mode=TwoWay}"
                            ToolTip.Tip="Rotate selected box"/>

                    <ToggleButton Content="□"
                            FontSize="20"
                            IsChecked="{Binding IsScaleMode, Mode=TwoWay}"
                            ToolTip.Tip="Scale selected box"/>

                    <Border Height="1"
                            Background="#41454A"
                            Margin="10,8"/>

                    <Button Content="+"
                            FontSize="24"
                            Width="36" Height="36" Padding="0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Foreground="#C69B65"
                            BorderBrush="Transparent"
                            ToolTip.Tip="Add box"
                            Command="{Binding AddBuildingVolumeCommand}" />

                </StackPanel>
            </Border>


            <!-- CENTRAL VIEWPORT -->

            <Grid Grid.Column="1"
                    Background="#202327">

                <controls:ViewportControl
                    Scene="{Binding Scene}"
                    SelectedVolume="{Binding SelectedVolume}"
                    TransformMode="{Binding CurrentTransformMode}"
                                        TransformSpace="{Binding CurrentTransformSpace}"
                    ShowVertices="{Binding ShowVertices}"
                    ShowEdges="{Binding ShowEdges}"
                    ShowFaces="{Binding ShowFaces}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="18"
                        Background="#292D32"
                        Padding="12,7">

                    <TextBlock Text="PERSPECTIVE"
                            FontSize="10"
                            Foreground="#B8BBC0"/>
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="18"
                        Padding="5"
                        Background="#292D32"
                        BorderBrush="#41454A"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton Content="Global"
                                Width="62" Height="30"
                                IsChecked="{Binding IsGlobalSpace, Mode=TwoWay}"
                                ToolTip.Tip="Use world axes"/>
                        <ToggleButton Content="Local"
                                Width="54" Height="30"
                                IsChecked="{Binding IsLocalSpace, Mode=TwoWay}"
                                ToolTip.Tip="Use object axes"/>
                        <Border Width="1" Height="20" Background="#41454A" VerticalAlignment="Center" Margin="3,0"/>
                        <ToggleButton Content="Verts"
                                Width="62" Height="30"
                                IsChecked="{Binding ShowVertices, Mode=TwoWay}"
                                ToolTip.Tip="Show vertices"/>
                        <ToggleButton Content="Edges"
                                Width="58" Height="30"
                                IsChecked="{Binding ShowEdges, Mode=TwoWay}"
                                ToolTip.Tip="Show thick box edges"/>
                        <ToggleButton Content="Faces"
                                Width="58" Height="30"
                                IsChecked="{Binding ShowFaces, Mode=TwoWay}"
                                ToolTip.Tip="Show shaded box faces"/>
                    </StackPanel>
                </Border>

            </Grid>


            <!-- RIGHT PROPERTIES PANEL -->

            <Border Grid.Column="2"
                    Background="#24272B"
                    BorderBrush="#35393E"
                    BorderThickness="1,0,0,0">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="18"
                                                                Spacing="18">

                
                <!-- SCENE HIERARCHY -->

                <TextBlock Text="OBJECTS"
                        FontSize="10"
                        Foreground="#C69B65"/>

                <Border Background="#202327"
                        BorderBrush="#35393E"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">

                                        
                    <ListBox ItemsSource="{Binding Volumes}"
                            SelectedItem="{Binding SelectedVolume, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                        FontSize="12"
                                        Foreground="#B8BBC0"
                                        Margin="4,6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>


                </Border>

                <Border Height="1" Background="#41454A"/>

                    <TextBlock Text="{Binding SelectedVolume.Name, FallbackValue='PROPERTIES'}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#EEEEEE"/>

                    <TextBlock Text="TRANSFORM"
                            FontSize="10"
                            Foreground="#C69B65"/>

                    <TextBlock Text="POSITION"
                            FontSize="11"
                            Foreground="#B8BBC0"/>

                    <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="8">

                        <TextBlock Text="X"
                                Foreground="#D66A60"
                                VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                Text="{Binding XInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1"
                                Text="Y"
                                Foreground="#79B879"
                                VerticalAlignment="Center"/>

                        <TextBox Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding YInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2"
                                Text="Z"
                                Foreground="#719BD6"
                                VerticalAlignment="Center"/>

                        <TextBox Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding ZInput, UpdateSourceTrigger=PropertyChanged}"/>

                    </Grid>

                    <TextBlock Text="ROTATION (DEG)"
                            FontSize="11"
                            Foreground="#B8BBC0"/>

                    <Grid ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="12"
                            RowSpacing="8">

                        <TextBlock Text="X" Foreground="#D66A60" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                Text="{Binding RotationXInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="Y" Foreground="#79B879" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                Text="{Binding RotationYInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Z" Foreground="#719BD6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                Text="{Binding RotationZInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="SCALE"
                            FontSize="11"
                            Foreground="#B8BBC0"/>

                    <Grid ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="12"
                            RowSpacing="8">

                        <TextBlock Text="X" Foreground="#D66A60" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                Text="{Binding ScaleXInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="Y" Foreground="#79B879" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                Text="{Binding ScaleYInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Z" Foreground="#719BD6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                Text="{Binding ScaleZInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Border Height="1" Background="#41454A"/>

                    
                    <!-- DIMENSIONS -->

                    <TextBlock Text="DIMENSIONS"
                            FontSize="10"
                            Foreground="#C69B65"/>

                    
                    <!-- WIDTH -->
                    <TextBlock Text="Width (m)"
                            FontSize="11"
                            Foreground="#B8BBC0"/>

                    <TextBox Text="{Binding WidthInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- DEPTH -->
                    <TextBlock Text="Depth (m)"
                            FontSize="11"
                            Foreground="#B8BBC0"/>

                    <TextBox Text="{Binding DepthInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- HEIGHT -->
                    <TextBlock Text="Height (m)"
                            FontSize="11"
                            Foreground="#B8BBC0"/>

                    <TextBox Text="{Binding HeightInput, UpdateSourceTrigger=PropertyChanged}"/>



                                        </StackPanel>
                                </ScrollViewer>
            </Border>

        </Grid>


                <!-- BOTTOM STATUS BAR -->

        <Border Grid.Row="2"
                Background="#292D32"
                BorderBrush="#35393E"
                BorderThickness="0,1,0,0">

            <Grid ColumnDefinitions="Auto,*,Auto"
            Margin="12,0">

                <!-- Left side -->
                <TextBlock Grid.Column="0"
                        Text="Ready"
                        FontSize="10"
                        Foreground="#858A91"
                        VerticalAlignment="Center"
                        />


                <TextBlock Grid.Column="1"
                Text="{Binding ObjectCount, StringFormat='Objects: {0}'}"
                FontSize="10"
                Foreground="#EEEEEE"
                VerticalAlignment="Center"
                Margin="0,0,18,0"/>


                <!-- Right side -->
                <TextBlock Grid.Column="2"
                        Text="COMPIS | DEVELOPMENT BUILD"
                        FontSize="10"
                        Foreground="#858A91"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"/>

                

            </Grid>
        </Border>

    </Grid>

</Window>
