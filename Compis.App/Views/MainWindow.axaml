
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Compis.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Compis.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Compis"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#191B1F">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="56,*,28"
          Background="#191B1F">

        <!-- TOP MENU BAR -->

        <Border Grid.Row="0"
                Background="#24272B"
                BorderBrush="#35393E"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="200,*,Auto"
                  Margin="20,0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="12">

                    <TextBlock Text="C"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#C69B65"/>

                    <TextBlock Text="COMPIS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#EEEEEE"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="24">

                    <TextBlock Text="File" Foreground="#B8BBC0"/>
                    <TextBlock Text="Edit" Foreground="#B8BBC0"/>
                    <TextBlock Text="View" Foreground="#B8BBC0"/>
                    <TextBlock Text="Create" Foreground="#B8BBC0"/>
                    <TextBlock Text="Tools" Foreground="#B8BBC0"/>
                    <TextBlock Text="Help" Foreground="#B8BBC0"/>

                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="UNTITLED PROJECT"
                           FontSize="10"
                           Foreground="#858A91"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>


        <!-- MAIN WORKSPACE -->

        <Grid Grid.Row="1"
              ColumnDefinitions="64,*,280">

            <!-- LEFT TOOLBAR -->

            <Border Grid.Column="0"
                    Background="#24272B"
                    BorderBrush="#35393E"
                    BorderThickness="0,0,1,0">

                <StackPanel Margin="0,18"
                            Spacing="12">

                    <Button Content="↖"
                            FontSize="22"
                            Background="#3A3E44"
                            Foreground="#D4AA77"/>

                    <Button Content="✥"
                            FontSize="20"
                            Background="Transparent"
                            Foreground="#B8BBC0"/>

                    <Button Content="↻"
                            FontSize="20"
                            Background="Transparent"
                            Foreground="#B8BBC0"/>

                    <Button Content="□"
                            FontSize="20"
                            Background="Transparent"
                            Foreground="#B8BBC0"/>

                    <Border Height="1"
                            Background="#41454A"
                            Margin="10,8"/>

                    <Button Content="+"
                            FontSize="24"
                            Background="Transparent"
                            Foreground="#C69B65"/>

                    <Button Content="▱"
                            FontSize="20"
                            Background="Transparent"
                            Foreground="#B8BBC0"/>

                </StackPanel>
            </Border>


            <!-- CENTRAL VIEWPORT -->

            <Grid Grid.Column="1"
                  Background="#202327">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">

                    <TextBlock Text="COMPIS"
                               FontSize="34"
                               FontWeight="Light"
                               Foreground="#555B63"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="3D VIEWPORT"
                               FontSize="11"
                               Foreground="#858A91"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Your architectural workspace"
                               FontSize="12"
                               Foreground="#666C73"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="18"
                        Background="#292D32"
                        Padding="12,7">

                    <TextBlock Text="PERSPECTIVE"
                               FontSize="10"
                               Foreground="#B8BBC0"/>

                </Border>

            </Grid>


            <!-- RIGHT PROPERTIES PANEL -->

            <Border Grid.Column="2"
                    Background="#24272B"
                    BorderBrush="#35393E"
                    BorderThickness="1,0,0,0">

                <StackPanel Margin="18"
                            Spacing="18">

                    <TextBlock Text="PROPERTIES"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#EEEEEE"/>

                    <Border Height="1"
                            Background="#41454A"/>

                    <TextBlock Text="SCENE"
                               FontSize="10"
                               Foreground="#C69B65"/>

                    <TextBlock Text="No object selected"
                               FontSize="12"
                               Foreground="#858A91"/>

                    <Border Height="1"
                            Background="#41454A"/>

                    <TextBlock Text="TRANSFORM"
                               FontSize="10"
                               Foreground="#C69B65"/>

                    <TextBlock Text="Location"
                               FontSize="12"
                               Foreground="#B8BBC0"/>

                    <TextBlock Text="X     0.00"
                               FontSize="12"
                               Foreground="#858A91"/>

                    <TextBlock Text="Y     0.00"
                               FontSize="12"
                               Foreground="#858A91"/>

                    <TextBlock Text="Z     0.00"
                               FontSize="12"
                               Foreground="#858A91"/>

                    <Border Height="1"
                            Background="#41454A"/>

                    <TextBlock Text="DIMENSIONS"
                               FontSize="10"
                               Foreground="#C69B65"/>

                    <TextBlock Text="No dimensions available"
                               FontSize="12"
                               Foreground="#858A91"/>

                </StackPanel>
            </Border>

        </Grid>


        <!-- BOTTOM STATUS BAR -->

        <Border Grid.Row="2"
                Background="#292D32"
                BorderBrush="#35393E"
                BorderThickness="0,1,0,0">

            <Grid ColumnDefinitions="*,Auto"
                  Margin="12,0">

                <TextBlock Text="Ready"
                           FontSize="10"
                           Foreground="#858A91"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="COMPIS | DEVELOPMENT BUILD"
                           FontSize="10"
                           Foreground="#858A91"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

    </Grid>

</Window>
